{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "transgui-next",
  "version": "0.1.0",
  "identifier": "com.tk1n.transguinext",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "transgui-next",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent metainfo",
        "description": "BitTorrent metainfo file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
